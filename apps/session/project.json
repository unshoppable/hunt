{
  "name": "session",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/session/src",
  "tags": [
    "type:backend"
  ],
  "implicitDependencies": [
    "vm",
    "scripts"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/session"
      ],
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/project.json",
        "{workspaceRoot}/scripts/buildVmArtifact.ts",
        {
          "env": "APP_VERSION"
        }
      ],
      "options": {
        "command": "node scripts/buildVmArtifact.ts session"
      }
    },
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/session/tsconfig.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/session"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "apps/session"
      },
      "dependsOn": [
        "build",
        "typecheck-tests",
        {
          "projects": [
            "scripts"
          ],
          "target": "typecheck-tests"
        }
      ]
    }
  }
}
