# The environment of Hunt's agent on a session VM: hunt-relay.service reads it as an EnvironmentFile, `hunt-ctl deps`
# runs the package manager with it and /etc/profile.d/hunt.sh (profile.sh) exports it in the agent's login shells. One
# NAME=value per line without quotes, spaces or expansions, so that systemd and a POSIX shell read it alike.
SHELL=/bin/bash
# Volta's shims first, so that node and npm follow a repository's `volta` pins.
PATH=/opt/volta/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
VOLTA_HOME=/opt/volta
# No NPM_CONFIG_GLOBALCONFIG: the VM's npm registry cache (/opt/hunt/node/etc/npmrc) serves `hunt-ctl deps` only. An
# `npm install <package>` of the agent through the cache would write the cache's URLs into the lockfile, which CI
# cannot reach; the agent's npm therefore talks to registry.npmjs.org and finds what `hunt-ctl deps` fetched in ~/.npm.
CLAUDE_CONFIG_DIR=/home/agent/.claude
HUNT_CONFIG=/home/agent/.claude/hunt-session.json
HUNT_SOCKET_DIR=/run/hunt
HUNT_ADAPTER=/opt/hunt/agent/acp/node_modules/@agentclientprotocol/claude-agent-acp/dist/index.js
HUNT_MCP_SERVERS=/srv/hunt/current/session/mcp-servers.json
DISABLE_TELEMETRY=1
DISABLE_ERROR_REPORTING=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_AUTOUPDATER=1
GH_NO_UPDATE_NOTIFIER=1
GH_PROMPT_DISABLED=1
GIT_TERMINAL_PROMPT=0
