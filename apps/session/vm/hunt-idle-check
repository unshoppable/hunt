#!/usr/bin/env bash
# Decides every minute (hunt-idle.timer) whether the session on this VM is idle. Once it has been idle for IDLE_MINUTES
# the script reports it, and the gateway's sweeper (`apps/gateway/src/session-vm/idle-sweeper.service.ts`), which runs it with --dry-run over SSH,
# suspends the VM: a VM cannot suspend itself. The VM powers itself off only when SUSPEND_WAIT_MINUTES pass idle without
# a suspend, so that a gateway that cannot suspend (an outage, a missing permission) does not leave it running. The disk
# keeps everything; Hunt or the gateway resumes or starts the VM again when the session is needed. With --dry-run it
# prints its decision ("keep: <reason>", "idle: <reason>" or "poweroff: <reason>") and changes nothing.
#
# The VM stays up while
#   - it booted, or resumed from a suspend, less than BOOT_GRACE_MINUTES ago (a resume shows as a gap of more than
#     RESUME_GAP_SECONDS between two runs, which the timer never leaves on its own),
#   - hunt-ctl runs, or ran within IDLE_MINUTES (the mtime of /var/lib/hunt/activity),
#   - a check of the Checks tab runs: a window of the agent's tmux with the option @hunt-check whose program has not
#     ended,
#   - the relay, with a fresh heartbeat in its status file (/run/hunt/status.json), has a running turn, or a turn ended,
#     a client sent something or a permission request arrived within IDLE_MINUTES (an unanswered permission request
#     counts as idle after that),
#   - someone opened a preview page or sent a request other than GET within IDLE_MINUTES (the access log of the VM's
#     preview proxy; health checks are not logged), but only while the agent was active within PREVIEW_MAX_MINUTES, so
#     that a forgotten browser tab cannot keep the VM running,
#   - an interactive login, such as Hunt's terminal, had input within IDLE_MINUTES (the IDLE column of `w`).
# Dev servers, the services of hunt.json (hunt-service@ units) included, and containers the agent left running do not
# count. A heartbeat older than two minutes means the relay is gone; its status does not count. IDLE_MINUTES,
# BOOT_GRACE_MINUTES, PREVIEW_MAX_MINUTES and SUSPEND_WAIT_MINUTES come from /etc/hunt/idle.conf (defaults 30, 15, 120
# and 15). The state of the runs (when the last one ran, when the VM resumed, since when it is idle) lives in
# /run/hunt, which a boot clears and a suspend keeps. The HUNT_IDLE_* variables point it at other files, for tests.
set -euo pipefail

config=${HUNT_IDLE_CONFIG:-/etc/hunt/idle.conf}
status_file=${HUNT_IDLE_STATUS_FILE:-/run/hunt/status.json}
activity_file=${HUNT_IDLE_ACTIVITY_FILE:-/var/lib/hunt/activity}
uptime_file=${HUNT_IDLE_UPTIME_FILE:-/proc/uptime}
proxy_log=${HUNT_IDLE_PROXY_LOG:-/var/log/hunt-proxy/access.log}
state_dir=${HUNT_IDLE_STATE_DIR:-/run/hunt}
last_run_file=$state_dir/idle-last-run
idle_since_file=$state_dir/idle-since
readonly HEARTBEAT_MAX_AGE_MS=120000
readonly RESUME_GAP_SECONDS=180

IDLE_MINUTES=30
BOOT_GRACE_MINUTES=15
PREVIEW_MAX_MINUTES=120
SUSPEND_WAIT_MINUTES=15

# Reads IDLE_MINUTES, BOOT_GRACE_MINUTES, PREVIEW_MAX_MINUTES and SUSPEND_WAIT_MINUTES from the config file; other lines
# and malformed values are ignored.
read_config() {
  local key value
  [[ -r $config ]] || return 0
  while IFS='=' read -r key value || [[ -n $key ]]; do
    key=${key//[[:space:]]/}
    value=${value//[[:space:]\"\']/}
    if [[ $key =~ ^(IDLE_MINUTES|BOOT_GRACE_MINUTES|PREVIEW_MAX_MINUTES|SUSPEND_WAIT_MINUTES)$ && $value =~ ^[0-9]+$ ]]; then
      printf -v "$key" '%d' "$((10#$value))"
    fi
  done <"$config"
}

# Prints the minutes since the most recent input of any interactive login, read from the IDLE column of `w`
# ("12.00s", "4:05" for minutes:seconds, "1:05m" for hours:minutes, "3days"); prints nothing without logins.
login_idle_minutes() {
  LC_ALL=C w | awk '
    function minutes(idle, parts) {
      if (idle ~ /days$/) return idle * 1440
      if (idle ~ /^[0-9]+:[0-9]+m$/) { split(idle, parts, ":"); return parts[1] * 60 + parts[2] }
      if (idle ~ /^[0-9]+:[0-9]+$/) { split(idle, parts, ":"); return parts[1] + 0 }
      return 0
    }
    !column { for (i = 1; i <= NF; i++) if ($i == "IDLE") column = i; next }
    { idle = minutes($column); if (least == "" || idle < least) least = idle }
    END { if (least != "") print least }'
}

# Prints the time in ms of the newest page load or non-GET request in the preview proxy's access log; nothing without
# one.
last_preview_request_ms() {
  [[ -f $proxy_log ]] || return 0
  tail -c 262144 "$proxy_log" | jq -Rr '
    fromjson? | select(.request.method as $method | ($method != "GET" and $method != "HEAD" and $method != "OPTIONS")
      or ((.request.headers["Sec-Fetch-Mode"] // [])[0] == "navigate")) | .ts * 1000 | floor' 2>/dev/null | tail -n 1
}

# Prints the hunt.json checks whose program still runs in a window of the agent's tmux, one per line; nothing without a
# tmux server.
running_checks() {
  runuser -u agent -- tmux list-windows -a -F '#{pane_dead} #{@hunt-check}' 2>/dev/null | awk '$1 == 0 && $2 != "" { print $2 }' || true
}

# Prints what keeps the relay busy ("a turn is running"); nothing when it is idle or gone.
relay_busy_reason() {
  local reason
  [[ -f $status_file ]] || return 0
  reason=$(jq -r --argjson now "$1" --argjson idle "$((IDLE_MINUTES * 60000))" --argjson maxAge "$HEARTBEAT_MAX_AGE_MS" '
    def within($time): ($time // 0) > $now - $idle;
    if (.heartbeatAt // 0) < $now - $maxAge then empty
    elif .turn == "running" then "a turn is running"
    elif within(.lastTurnEndedAt) then "a turn ended within \($idle / 60000) min"
    elif within(.lastClientActivityAt) then "a client sent something within \($idle / 60000) min"
    elif within(.pendingPermissionSince) then "a permission request arrived within \($idle / 60000) min"
    else empty end' "$status_file" 2>/dev/null) || reason=
  echo "$reason"
}

# Prints the time in ms of the newest activity of the agent (a running turn counts as now); 0 when the relay is gone.
last_agent_activity_ms() {
  local time=0
  if [[ -f $status_file ]]; then
    time=$(jq -r --argjson now "$1" --argjson maxAge "$HEARTBEAT_MAX_AGE_MS" '
      if (.heartbeatAt // 0) < $now - $maxAge then 0
      elif .turn == "running" then $now
      else [.lastTurnEndedAt // 0, .lastClientActivityAt // 0] | max end' "$status_file" 2>/dev/null) || time=
  fi
  if [[ $time =~ ^[0-9]+$ ]]; then
    echo "$time"
  else
    echo 0
  fi
}

# Prints the seconds since the VM last resumed from a suspend, given the current time in seconds: 0 when the last run
# was more than RESUME_GAP_SECONDS ago (the VM was suspended in between), else the time since the resume the last run
# recorded; nothing when the VM has not resumed since it booted. `record_run` keeps the file this reads.
seconds_since_resume() {
  local last_run resumed_at
  [[ -r $last_run_file ]] || return 0
  read -r last_run resumed_at <"$last_run_file" || true
  [[ $last_run =~ ^[0-9]+$ ]] || return 0
  if (( $1 - last_run > RESUME_GAP_SECONDS )); then
    echo 0
  elif [[ $resumed_at =~ ^[0-9]+$ ]]; then
    echo $(( $1 - resumed_at ))
  fi
  return 0
}

# Records this run for `seconds_since_resume`: the current time in seconds and, when the VM resumed, when it did.
record_run() {
  local since resumed_at=
  since=$(seconds_since_resume "$1")
  if [[ -n $since ]]; then
    resumed_at=$(( $1 - since ))
  fi
  mkdir -p "$state_dir"
  echo "$1 $resumed_at" >"$last_run_file"
}

# Prints the seconds the VM has been idle according to the idle-since file, given the current time in seconds; nothing
# when the last run found it busy.
seconds_idle() {
  local since
  [[ -r $idle_since_file ]] || return 0
  read -r since <"$idle_since_file" || true
  if [[ $since =~ ^[0-9]+$ ]]; then
    echo $(( $1 - since ))
  fi
  return 0
}

decide() {
  local now_ms uptime resumed modified activity_age checks reason login_idle preview_ms idle
  now_ms=$(date +%s%3N)
  read -r uptime _ <"$uptime_file"
  uptime=${uptime%.*}
  if (( uptime < BOOT_GRACE_MINUTES * 60 )); then
    echo "keep: booted $((uptime / 60)) min ago, within the grace period of $BOOT_GRACE_MINUTES min"
    return
  fi
  resumed=$(seconds_since_resume "$((now_ms / 1000))")
  if [[ -n $resumed ]] && (( resumed < BOOT_GRACE_MINUTES * 60 )); then
    echo "keep: resumed $((resumed / 60)) min ago, within the grace period of $BOOT_GRACE_MINUTES min"
    return
  fi

  if [[ -e $activity_file ]]; then
    modified=$(stat -c %Y "$activity_file")
    activity_age=$((now_ms / 1000 - modified))
    if (( activity_age < IDLE_MINUTES * 60 )); then
      echo "keep: hunt-ctl ran $((activity_age / 60)) min ago"
      return
    fi
  fi
  # hunt-ctl runs as `bash …/hunt-ctl <command>`, so only its command line names it.
  if pgrep -f '/hunt-ctl( |$)' >/dev/null; then
    echo "keep: hunt-ctl is running"
    return
  fi
  checks=$(running_checks)
  if [[ -n $checks ]]; then
    echo "keep: the check ${checks//$'\n'/, } is running"
    return
  fi

  reason=$(relay_busy_reason "$now_ms")
  if [[ -n $reason ]]; then
    echo "keep: $reason"
    return
  fi

  preview_ms=$(last_preview_request_ms)
  if [[ $preview_ms =~ ^[0-9]+$ ]] && (( preview_ms > now_ms - IDLE_MINUTES * 60000 )) &&
    (( $(last_agent_activity_ms "$now_ms") > now_ms - PREVIEW_MAX_MINUTES * 60000 )); then
    echo "keep: a preview page was used $(((now_ms - preview_ms) / 60000)) min ago"
    return
  fi

  login_idle=$(login_idle_minutes)
  if [[ -n $login_idle ]] && (( login_idle < IDLE_MINUTES )); then
    echo "keep: an interactive login had input $login_idle min ago"
    return
  fi
  idle=$(seconds_idle "$((now_ms / 1000))")
  if [[ -n $idle ]] && (( idle >= SUSPEND_WAIT_MINUTES * 60 )); then
    echo "poweroff: idle for $((idle / 60)) min and not suspended by the gateway"
    return
  fi
  echo "idle: no turn, client, permission request, preview page view, login or hunt-ctl activity for $IDLE_MINUTES min"
}

dry_run=false
case ${1-} in
  --dry-run) dry_run=true ;;
  "") ;;
  *)
    echo "usage: hunt-idle-check [--dry-run]" >&2
    exit 2
    ;;
esac
read_config
decision=$(decide)
if $dry_run; then
  echo "$decision"
  exit 0
fi
now_s=$(( $(date +%s%3N) / 1000 ))
record_run "$now_s"
case $decision in
  keep:*)
    rm -f "$idle_since_file"
    ;;
  idle:*)
    if [[ ! -e $idle_since_file ]]; then
      echo "$now_s" >"$idle_since_file"
      echo "${decision#idle: }; waiting for the gateway to suspend the VM"
    fi
    ;;
  poweroff:*)
    echo "${decision#poweroff: }; powering off"
    systemctl poweroff
    ;;
esac
