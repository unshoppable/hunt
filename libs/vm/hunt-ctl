#!/usr/bin/env bash
# hunt-ctl: the VM side of Hunt's remote sessions. Hunt runs it over SSH as `sudo -n hunt-ctl <command> …`. Every
# command prints one JSON document on stdout, except the streaming ones (receive-pack, upload-pack, lfs-get,
# get-claude, check), which pass raw data; progress and errors go to stderr, errors with a non-zero exit. Without
# arguments it lists the commands.
#
# /etc/hunt/role names the kind of VM. A session VM (`session`) runs one session: its worktree, ~/.claude and agent
# belong to the user agent, the relay runs as hunt-relay.service and the services of its hunt.json as
# hunt-service@<name>.service, which the agent starts and stops through `sudo -n hunt-ctl service`. The VM is the isolation boundary: whatever hunt-ctl does in the
# session's files runs as agent, so the agent's Git hooks, config and symlinks act with no more rights than the agent
# has anyway. The gateway (`gateway`) holds no sessions: its edge proxy forwards the preview hosts to the session VMs,
# hunt-wake.service starts a stopped one, hunt-api.service creates, starts and deletes them for the desktop apps, and
# hunt-swf.service starts sessions for GitHub issues, suspends idle session VMs and deletes session VMs off for more than
# a week. CI deploys both releases by SSH into the gateway: `install` for the gateway's own, `stage-session` for the one
# the gateway installs on the session VMs.
# shellcheck disable=SC2016 # jq programs and `sh -c` scripts are single-quoted on purpose.
set -Eeuo pipefail
shopt -s inherit_errexit nullglob

readonly ROLE_FILE=/etc/hunt/role
readonly RELEASES=/srv/hunt/releases
readonly CURRENT=/srv/hunt/current
readonly STATE_DIR=/var/lib/hunt
readonly ACTIVITY_FILE=/var/lib/hunt/activity
# The hash of the last install that completed; written last, so an install that failed anywhere is repeated. The gateway
# compares it with the session release it staged before it installs that on a session VM.
readonly INSTALLED_HASH_FILE=/var/lib/hunt/installed-hash
readonly UNIT_DIR=/etc/systemd/system
# A preview domain: at least two labels, the last of letters only, and room for `<short>-<port>-open.` in front of it
# within the 253 characters of a host name. apps/client/src-tauri/src/remote/preview.rs, libs/domain/src/session/preview-domain.rules.ts and
# Hunt's settings check the same.
readonly DOMAIN_PATTERN='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'
readonly MAX_DOMAIN_LENGTH=233
# Exit status of failures that were reported already; the ERR trap stays quiet for them.
readonly REPORTED=3
# The SYSLOG_IDENTIFIER of hunt-ctl's lines in the journal, which the infrastructure's Ops Agent ships to Cloud Logging.
readonly LOG_TAG=hunt-ctl
# How many of the last stderr lines of a failed command the journal gets, each cut to this many characters.
readonly STDERR_LOG_LINES=20
readonly STDERR_LINE_LIMIT=500
# A session id: a lowercase UUID.
readonly ID_PATTERN='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'

