readonly SUDOERS_DROPIN=/etc/sudoers.d/hunt-api
readonly EDGE_NAME=hunt-edge
readonly EDGE_CONFIG_DIR=/etc/hunt-edge
# The ports the load balancer's instance group serves, EDGE_PORT behind IAP (named port `http`) and EDGE_OPEN_PORT for
