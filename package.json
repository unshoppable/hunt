{
  "name": "hunt",
  "private": true,
  "license": "MIT",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "start:client": "nx run client:dev",
    "tauri": "cd apps/client && tauri",
    "build:all": "nx run-many -t build --all",
    "lint:all": "nx run-many -t lint --all",
    "test:all": "nx run-many -t test test-rust --all",
    "check": "nx run-many -t lint test test-rust --all",
    "nx": "nx",
    "prepare": "husky install && (git config --get-all remote.origin.fetch | grep -qF 'refs/tags/deployed' || git config --add remote.origin.fetch '+refs/tags/deployed/*:refs/tags/deployed/*')"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.89.1",
    "@agentclientprotocol/sdk": "^1.8.0",
    "@angular/language-server": "^22.2.3",
    "@git-diff-view/file": "^0.1.7",
    "@git-diff-view/react": "^0.1.7",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "diff": "^9.0.0",
    "elkjs": "^0.12.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.3",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@nx/js": "^23.1.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "husky": "^8.0.3",
    "nx": "^23.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "volta": {
    "node": "24.21.0",
    "npm": "11.19.0"
  }
}
