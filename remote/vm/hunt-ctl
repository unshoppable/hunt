#!/usr/bin/env bash
# hunt-ctl: the VM side of Hunt's remote sessions. Hunt runs it over SSH as `sudo -n hunt-ctl <command> …`. Every
# command prints one JSON document on stdout, except the streaming ones (receive-pack, upload-pack, lfs-get,
# get-claude), which pass raw data; progress and errors go to stderr, errors with a non-zero exit. Each session keeps
# its own repository in its worktree folder. Everything that reads or writes a session's files (git, tar, its
# hunt-session.json) runs in a throwaway container that sees only that session, so neither its Git hooks, filters and
# config nor symlinks its agent left there can act on the host. Without arguments it lists the commands.
# shellcheck disable=SC2016 # jq programs and `sh -c` scripts are single-quoted on purpose.
set -Eeuo pipefail
shopt -s inherit_errexit nullglob

readonly HOST_USER=hunt
readonly CONTAINER_USER=2000:2000
readonly CONTAINER_MEMORY=8g
# Memory limit of a session's container while its preview runs: the agent plus the dev servers.
readonly PREVIEW_MEMORY=11g
readonly CONTAINER_PIDS=4096
readonly RELEASES=/srv/hunt/releases
readonly CURRENT=/srv/hunt/current
readonly SESSIONS=/srv/hunt/sessions
readonly SOCKETS=/srv/hunt/sockets
readonly WORKTREES=/srv/worktrees
readonly CLAUDE_HOMES=/srv/claude
readonly NPM_CACHE=/srv/cache/npm
readonly NPM_CACHE_MAX_KB=$((10 * 1024 * 1024))
readonly PREVIEW_DIR=/srv/hunt/preview
readonly EDGE_NAME=hunt-edge
readonly EDGE_CONFIG_DIR=/etc/hunt-edge
readonly EDGE_LOG_DIR=/var/log/hunt-edge
# The port the load balancer's instance group serves (named port `http`) and its health path; Terraform uses the same.
readonly EDGE_PORT=8080
readonly EDGE_HEALTH_PATH=/hunt-healthz
readonly EDGE_USER=2001:2001
readonly EDGE_IMAGE=caddy:2-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
readonly REDIS_IMAGE=redis:7.2-alpine@sha256:29e8589c3f9ba699b5f7aa4b3c7733c58852a3626439e619aa0ee78de08c6ca0
readonly ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.0.4@sha256:59da431b8987b508af17a9424f1f03398ecaacc09c4218abe306749b524f1519
# Google's load balancer proxies and health checkers, the only clients the edge serves.
readonly -a LB_RANGES=(35.191.0.0/16 130.211.0.0/22)
# Memory the containers' limits leave to the VM itself.
readonly MEMORY_RESERVE_MB=3072
readonly STATE_DIR=/var/lib/hunt
readonly ACTIVITY_FILE=/var/lib/hunt/activity
readonly IDLE_CONFIG=/etc/hunt/idle.conf
readonly UNIT_DIR=/etc/systemd/system
# A relay whose status.json heartbeat is older than this is gone.
readonly HEARTBEAT_MAX_AGE_MS=120000
# Seconds `docker stop` gives the relay to close the adapter, which writes the transcript, before Docker kills it.
readonly STOP_TIMEOUT=30
# Exit status of failures that were reported already; the ERR trap stays quiet for them.
readonly REPORTED=3

# Removed when hunt-ctl exits.
temporary_paths=()
# Whether the command counts as activity for hunt-idle-check; read-only queries Hunt polls do not.
counts_as_activity=true

usage() {
  cat >&2 <<'USAGE'
usage: hunt-ctl <command> [arguments]

  install <dir>          install the bundle in <dir>: release, image hunt-agent:<hash>, systemd units; removes all
                         but this and the previous release and their images, the build cache and an npm cache
                         above 10 GB
  install-units          (re)install the systemd units, idle defaults and hunt-ctl link of the current release
  version                hash of the current release
  init <id> --repo <owner>/<repo>
                         create the session's empty repository (removing what an earlier handoff left)
  receive-pack <path>    git-receive-pack into the repository of the session at <path> (streams; for git push)
  upload-pack <path>     git-upload-pack from the repository of the session at <path> (streams; for git fetch)
  lfs-put <id>           unpack the tar.gz of Git LFS objects on stdin into the session's repository
  lfs-get <id>           write a tar.gz of the Git LFS objects listed on stdin, one <aa>/<bb>/<oid> per line (streams)
  put-files <id> [--claude]
                         unpack the tar.gz on stdin into the session's worktree, or with --claude into its ~/.claude
  get-claude <id> --project <slug>
                         write a tar.gz of hunt-session.json and projects/<slug> of the session's ~/.claude (streams)
  prepare <id> --branch <branch> --snapshot <ref> --git-name <name> --git-email <email> [--origin <url>]
          [--upstream <branch>] [--hooks-path <dir>]
                         check the session's branch out in its worktree, with the snapshot's changes applied; set
                         origin (a https://github.com URL), the branch's upstream on it and the hooks folder (relative
                         to the worktree; without one, Git LFS's hooks)
  deps <id>              install the worktree's dependencies (npm, pnpm or yarn, by lockfile)
  start <id>             start the session's container; a new one takes the tokens from stdin (see read_tokens)
  wait <id> [--timeout <seconds>]
                         wait until the session's relay serves its socket (default 120 seconds)
  stop <id>              stop the session's container
  clear <id>             restart the session's relay with a new conversation; the tokens come from stdin
  snapshot <id>          record the worktree's state as refs/hunt/<id>/retrieve
  status <id>            container state, relay status and session metadata
  destroy <id>           remove the session's containers, network, worktree and files
  preview start <id> --domain <domain> [--with <process>]…
                         start the session's preview from the `preview` section of its hunt.json; a container from
                         an older release is created anew, with the tokens from stdin
  preview status <id>    the preview's URLs, services and the relay's preview state
  preview logs <id> <process|setup> [--offset <bytes>] [--limit <bytes>]
                         part of a preview log, by default its last 64 KiB
  preview restart <id> <process>
                         restart one preview process
  preview stop <id>      stop the preview's processes, services and route; data stays
  preview reset <id>     stop the preview and delete its data, so the next start initializes it again
  edge-reset             (boot) forget every preview and (re)start the edge proxy with no routes
USAGE
  exit 2
}

die() {
  printf 'hunt-ctl: %s\n' "$*" >&2
  exit "$REPORTED"
}

# ERR trap: names the command that failed. A failing subshell stays quiet; the command that ran it is reported.
report_failure() {
  local status=$1 line=$2 command=$3
  (( status != REPORTED && BASH_SUBSHELL == 0 )) || return 0
  printf 'hunt-ctl: line %s: `%s` failed with exit status %s\n' "$line" "$command" "$status" >&2
}

on_exit() {
  local path
  if $counts_as_activity; then
    touch "$ACTIVITY_FILE" 2>/dev/null || true
  fi
  for path in "${temporary_paths[@]}"; do
    rm -rf -- "${path:?}"
  done
}

# Prints the JSON document `jq -n` builds from the arguments as the command's result.
emit() {
  jq -cn "$@" >&3
}

# Runs a command as the host user that owns the worktrees and the containers' files.
as_hunt() {
  runuser -u "$HOST_USER" -- "$@"
}

# Runs <program> [arguments…] as uid 2000 in a throwaway container of the current release's image (git, Git LFS, tar,
# jq) with no network, no capabilities and a read-only root. It sees only the folders named with --mount, at their host
# paths. Options before `--`: --mount <dir> (repeatable), --stdin (passes standard input), --env <NAME=value>.
sandbox() {
  local -a flags=(--rm --pull never --network none --cap-drop ALL --security-opt no-new-privileges --read-only
    --tmpfs /tmp --pids-limit 512 --memory 2g --user "$CONTAINER_USER" --env HOME=/tmp)
  while (( $# )); do
    case $1 in
      --mount)
        flags+=(--mount "type=bind,src=$2,dst=$2")
        shift 2
        ;;
      --stdin)
        flags+=(--interactive)
        shift
        ;;
      --env)
        flags+=(--env "$2")
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *) die "sandbox: unknown option $1" ;;
    esac
  done
  docker run "${flags[@]}" --entrypoint "$1" "hunt-agent:$(current_hash)" "${@:2}"
}

# The Docker network of session $1. Each session has its own bridge (interface hs-<first 8 hex digits of the id>), so
# containers of different sessions cannot reach each other; hunt-firewall.service keeps them off the VM's own services.
session_network() {
  printf 'hunt-net-%s\n' "$1"
}

ensure_session_network() {
  local name
  name=$(session_network "$1")
  docker network inspect "$name" >/dev/null 2>&1 && return
  docker network create --driver bridge --opt "com.docker.network.bridge.name=hs-${1:0:8}" --label "hunt.session=$1" "$name" >/dev/null
}

# Flags every long-running container of a session gets: its network, no capabilities, no privilege gain, a process cap.
container_flags() {
  printf '%s\n' --network "$(session_network "$1")" --cap-drop ALL --security-opt no-new-privileges --pids-limit "$CONTAINER_PIDS"
}

now_ms() {
  date +%s%3N
}

require_id() {
  [[ $1 =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || die "invalid session id: $1"
}

# <owner>/<repo> from the characters Hunt keeps in repository keys; no part starts with a dot.
require_repository_key() {
  local part='[A-Za-z0-9_-][A-Za-z0-9_.-]*'
  [[ $1 =~ ^$part/$part$ ]] || die "invalid repository: $1 (expected <owner>/<repo>)"
}

# Rejects empty values and line breaks, which container.env cannot carry.
require_line() {
  [[ -n $2 && $2 != *[$'\n\r']* ]] || die "invalid $1: expected one non-empty line"
}

require_prepared() {
  [[ -f $SESSIONS/$1/meta.json && -d $WORKTREES/$1 ]] || die "session $1 is not prepared on this VM"
}

# Prints field $2 of meta.json of session $1.
meta() {
  jq -er --arg field "$2" '.[$field] | strings' "$SESSIONS/$1/meta.json" || die "meta.json of session $1 has no $2"
}

current_hash() {
  [[ -f $CURRENT/.hash ]] || die "no Hunt release is installed; run hunt-ctl install first"
  tr -d '[:space:]' <"$CURRENT/.hash"
}

# Prints the JSON object in file $1 on one line, or null when the file is missing, a symlink or holds anything else.
# With --agent the file lies where a session's container writes (its socket folder), so it is read as `hunt`.
read_object() {
  local text=''
  local -a reader=()
  if [[ $1 == --agent ]]; then
    reader=(as_hunt)
    shift
  fi
  if [[ -f $1 && ! -L $1 ]]; then
    text=$("${reader[@]}" jq -c 'select(type == "object")' "$1" 2>/dev/null) || text=
  fi
  if [[ -z $text || $text == *$'\n'* ]]; then
    text=null
  fi
  printf '%s\n' "$text"
}

# Prints Docker's state of container $1 (created, running, restarting, exited, …) or `missing`.
container_state() {
  local listing name state
  listing=$(docker ps --all --filter "name=$1" --format '{{.Names}} {{.State}}')
  while read -r name state; do
    if [[ $name == "$1" ]]; then
      printf '%s\n' "$state"
      return
    fi
  done <<<"$listing"
  echo missing
}

# Creates the host folders the containers of session $1 mount, owned by the uid the containers run as.
ensure_session_dirs() {
  install -d -m 0755 "$SESSIONS" "$CLAUDE_HOMES" "${NPM_CACHE%/*}"
  install -d -m 0700 "$SESSIONS/$1"
  install -d -o "$HOST_USER" -g "$HOST_USER" -m 0700 "$CLAUDE_HOMES/$1"
  install -d -o "$HOST_USER" -g "$HOST_USER" -m 0755 "$SOCKETS" "$SOCKETS/$1" "$NPM_CACHE"
}

# Sets the caller's array `mounts` to the bind mounts every container of session $1 gets: the worktree with its
# repository under its host path, ~/.claude and the npm cache.
session_mounts() {
  local worktree=$WORKTREES/$1
  mounts=(
    --mount "type=bind,src=$worktree,dst=$worktree"
    --mount "type=bind,src=$CLAUDE_HOMES/$1,dst=/home/agent/.claude"
    --mount "type=bind,src=$NPM_CACHE,dst=/home/agent/.npm"
  )
}

# Reads the tokens Hunt sends on stdin into the caller's claude_token and github_token: the Claude Code OAuth token of
# the Claude account picked in Hunt by whoever starts the session on the first line, and that user's GitHub token on the
# second, which is empty or missing without one. The VM keeps them only in the session's container.env and container.
read_tokens() {
  claude_token=
  github_token=
  IFS= read -r claude_token || true
  IFS= read -r github_token || true
  [[ -n $claude_token && $claude_token != *[[:space:]]* ]] || die "no Claude Code OAuth token on stdin: pick a Claude account in Hunt, the local login cannot run on the VM"
  [[ $github_token != *[[:space:]]* ]] || die "invalid GitHub token on stdin: it contains whitespace"
}

# Rewrites container.env of session $1: the Claude Code token $2, the GitHub token $3 (`gh`, and git through gh's
# credential helper) when not empty, and the git identity of meta.json.
write_container_env() {
  local file=$SESSIONS/$1/container.env token=$2 github_token=$3 git_name git_email
  git_name=$(meta "$1" gitName)
  git_email=$(meta "$1" gitEmail)
  rm -f -- "${file:?}.tmp"
  (
    umask 077
    printf '%s=%s\n' CLAUDE_CODE_OAUTH_TOKEN "$token" GIT_AUTHOR_NAME "$git_name" GIT_AUTHOR_EMAIL "$git_email" \
      GIT_COMMITTER_NAME "$git_name" GIT_COMMITTER_EMAIL "$git_email" HUNT_SESSION_ID "$1" >"$file.tmp"
    if [[ -n $github_token ]]; then
      printf '%s=%s\n' GH_TOKEN "$github_token" >>"$file.tmp"
    fi
  )
  mv -f "$file.tmp" "$file"
}

# Starts the container of session $1 unless it runs. A stopped container is created anew, from the current release's
# image: Docker reads container.env only when it creates a container, so only a new one gets a rotated token, and the
# relay is as new as the bundle Hunt installed last. Everything a session keeps lives in its mounts.
start_container() {
  local id=$1 name=hunt-$1 state image claude_token github_token memory
  local -a mounts flags
  ensure_session_dirs "$id"
  state=$(container_state "$name")
  case $state in
    running | restarting) return ;;
  esac
  read_tokens
  write_container_env "$id" "$claude_token" "$github_token"
  # The previous relay's status would pass for the new one's until the new relay replaces it.
  rm -f -- "${SOCKETS:?}/${id:?}/status.json"
  if [[ $state != missing ]]; then
    docker rm --force "$name" >/dev/null
  fi
  image=hunt-agent:$(current_hash)
  jq --arg image "$image" '.image = $image' "$SESSIONS/$id/meta.json" >"$SESSIONS/$id/meta.json.tmp"
  mv -f "$SESSIONS/$id/meta.json.tmp" "$SESSIONS/$id/meta.json"
  session_mounts "$id"
  ensure_session_network "$id"
  mapfile -t flags < <(container_flags "$id")
  memory=$CONTAINER_MEMORY
  if [[ -f $SESSIONS/$id/preview-plan.json ]]; then
    memory=$PREVIEW_MEMORY
  fi
  # The agent's headless Chromium needs more shared memory than Docker's default 64 MB.
  docker run --detach --init --restart unless-stopped --pull never --name "$name" --memory "$memory" --memory-swap "$memory" \
    --shm-size 1g --stop-timeout "$STOP_TIMEOUT" "${flags[@]}" --env-file "$SESSIONS/$id/container.env" --user "$CONTAINER_USER" \
    "${mounts[@]}" --mount "type=bind,src=$SOCKETS/$id,dst=/run/hunt/socket" --workdir "$WORKTREES/$id" "$image" >/dev/null
  # A new container has a new address; the relay resumes the preview's processes on its own.
  if [[ -f $SESSIONS/$id/preview-routes.json ]]; then
    edge_sync
  fi
}

# Whether a connection to the Unix socket $1 succeeds.
socket_accepts() {
  [[ -S $1 ]] && timeout 5 socat -u OPEN:/dev/null "UNIX-CONNECT:$1" 2>/dev/null
}

# Fails with message $2, followed by the last log lines of container $1.
fail_wait() {
  printf 'hunt-ctl: %s\nlast log lines of %s:\n' "$2" "$1" >&2
  docker logs --tail 20 "$1" >&2 2>&1 || true
  exit "$REPORTED"
}

# Waits up to $2 seconds until the relay of session $1 is ready with a fresh heartbeat and its socket takes connections,
# then prints its status.json as the command's result. $3, the JSON of an acpSessionId, makes it also wait until the
# relay serves another session. A connected client proves the socket, so the socket is then not probed.
wait_until_ready() {
  local id=$1 timeout=$2 previous=${3-} name=hunt-$1
  local status_file=$SOCKETS/$1/status.json socket=$SOCKETS/$1/acp.sock
  local deadline=$((SECONDS + timeout)) stopped_polls=0 status verdict state
  while :; do
    status=$(read_object --agent "$status_file")
    verdict=$(jq -r --argjson now "$(now_ms)" --argjson maxAge "$HEARTBEAT_MAX_AGE_MS" --argjson previous "${previous:-null}" \
      --arg needsNewSession "${previous:+yes}" '
        if . == null or (.heartbeatAt // 0) < $now - $maxAge then "stale"
        elif .state == "failed" then "failed"
        elif .state != "ready" then "starting"
        elif $needsNewSession == "yes" and (.acpSessionId == null or .acpSessionId == $previous) then "starting"
        elif .clientConnected == true then "connected"
        else "ready" end' <<<"$status")
    case $verdict in
      failed) fail_wait "$name" "the agent failed to start: $(jq -r '.error // "no reason given"' <<<"$status")" ;;
      connected)
        printf '%s\n' "$status" >&3
        return
        ;;
      ready)
        if socket_accepts "$socket"; then
          printf '%s\n' "$status" >&3
          return
        fi
        ;;
    esac
    state=$(container_state "$name")
    case $state in
      running | restarting) stopped_polls=0 ;;
      missing) die "container $name does not exist; run hunt-ctl start first" ;;
      *) (( ++stopped_polls < 4 )) || fail_wait "$name" "container $name is $state" ;;
    esac
    (( SECONDS < deadline )) || fail_wait "$name" "the agent in $name was not ready within ${timeout}s (relay status: $verdict)"
    sleep 0.5
  done
}

# Installs the systemd units, the idle defaults and the hunt-ctl link of the current release and (re)starts them.
install_units() {
  local unit
  [[ -d $CURRENT/vm/systemd ]] || die "no Hunt release is installed; run hunt-ctl install first"
  for unit in "$CURRENT"/vm/systemd/*.service "$CURRENT"/vm/systemd/*.timer; do
    install -m 0644 "$unit" "$UNIT_DIR/"
  done
  if [[ ! -f $IDLE_CONFIG ]]; then
    install -d -m 0755 "${IDLE_CONFIG%/*}"
    printf 'IDLE_MINUTES=30\nBOOT_GRACE_MINUTES=15\n' >"$IDLE_CONFIG"
  fi
  ln -sfn "$CURRENT/vm/hunt-ctl" /usr/local/bin/hunt-ctl
  systemctl daemon-reload
  systemctl enable hunt-firewall.service hunt-boot.service hunt-idle.timer
  # Restarting re-runs the oneshot units, so the metadata server block and the socket folder are in place afterwards.
  systemctl restart hunt-firewall.service hunt-boot.service
  systemctl start hunt-idle.timer
}

# Removes the releases and the images built from them (hunt-agent, hunt-postgres18) except those of the hashes given.
# Docker refuses to remove an image a container still uses; such an image goes with a later install.
prune_releases() {
  local release hash repository tag
  for release in "$RELEASES"/*/; do
    hash=${release%/}
    hash=${hash##*/}
    [[ " $* " == *" $hash "* ]] && continue
    rm -rf -- "${release:?}"
  done
  for repository in hunt-agent hunt-postgres18; do
    while read -r tag; do
      [[ $tag == "<none>" || " $* " == *" $tag "* ]] && continue
      docker image rm "$repository:$tag" >/dev/null 2>&1 || true
    done < <(docker image ls --format '{{.Tag}}' "$repository")
  done
}

# Removes Docker's build cache and empties the shared npm cache once it holds more than NPM_CACHE_MAX_KB, unless a
# `hunt-ctl deps` container uses it right now; npm fills it again on demand. Failures leave the caches as they are.
prune_caches() {
  local size
  docker builder prune --force >/dev/null 2>&1 || true
  size=$(du -sk "$NPM_CACHE" 2>/dev/null | cut -f1) || return 0
  (( ${size:-0} > NPM_CACHE_MAX_KB )) || return 0
  [[ -z $(docker ps --quiet --filter name=hunt-deps- 2>/dev/null) ]] || return 0
  find "$NPM_CACHE" -mindepth 1 -delete 2>/dev/null || true
}

cmd_install() {
  (( $# == 1 )) || usage
  local source=$1 hash release staging previous
  [[ -f $source/.hash && -f $source/image/Dockerfile && -f $source/vm/hunt-ctl ]] || die "$source is not a Hunt remote bundle"
  hash=$(tr -d '[:space:]' <"$source/.hash")
  [[ $hash =~ ^[0-9a-f]{16}$ ]] || die "invalid bundle hash in $source/.hash: $hash"

  install -d -m 0755 "$RELEASES"
  exec 9>"$STATE_DIR/install.lock"
  flock --wait 1800 9 || die "another hunt-ctl install did not finish within 30 minutes"

  release=$RELEASES/$hash
  if [[ ! -d $release ]]; then
    staging=$(mktemp -d "$RELEASES/.$hash.XXXXXX")
    temporary_paths+=("$staging")
    # Copied without ownership: the release belongs to root, whoever uploaded the bundle.
    cp -R "$source/." "$staging/"
    chmod -R go-w "$staging"
    chmod 0755 "$staging" "$staging/vm/hunt-ctl" "$staging/vm/hunt-idle-check"
    mv -T "$staging" "$release"
  fi
  if ! docker image inspect "hunt-agent:$hash" >/dev/null 2>&1; then
    docker build --tag "hunt-agent:$hash" --file "$release/image/Dockerfile" "$release"
  fi
  if ! docker image inspect "hunt-postgres18:$hash" >/dev/null 2>&1; then
    docker build --tag "hunt-postgres18:$hash" --file "$release/image/services/postgres18.Dockerfile" "$release/image/services"
  fi
  docker pull --quiet "$REDIS_IMAGE" >/dev/null
  docker pull --quiet "$ELASTICSEARCH_IMAGE" >/dev/null
  docker pull --quiet "$EDGE_IMAGE" >/dev/null
  previous=$(tr -d '[:space:]' <"$CURRENT/.hash" 2>/dev/null || true)
  ln -sfn "$release" "$CURRENT.new"
  mv -T "$CURRENT.new" "$CURRENT"
  install_units
  ensure_edge
  # The release before stays, so that switching back to it, as a second Hunt version does, needs no new build.
  prune_releases "$hash" "$previous"
  prune_caches
  emit --arg hash "$hash" '{hash: $hash}'
}

cmd_install_units() {
  (( $# == 0 )) || usage
  install_units
  emit '{}'
}

cmd_version() {
  (( $# == 0 )) || usage
  local hash
  if [[ ! -f $CURRENT/.hash ]]; then
    emit '{hash: null}'
    return
  fi
  hash=$(current_hash)
  emit --arg hash "$hash" '{hash: $hash}'
}

# Path of the repository folder of a session: $WORKTREES/<id>, as git passes it to receive-pack and upload-pack (quoted
# or not); prints the id.
session_of_path() {
  local path=${1%/}
  path=${path#\'}
  path=${path%\'}
  [[ $path == "$WORKTREES"/* ]] || die "not a session repository: $1"
  local id=${path#"$WORKTREES"/}
  require_id "$id"
  [[ -d $WORKTREES/$id/.git ]] || die "session $id has no repository on this VM"
  printf '%s\n' "$id"
}

cmd_init() {
  (( $# == 3 )) && [[ $2 == --repo ]] || usage
  local id=$1 repo=$3 worktree created_at
  require_id "$id"
  require_repository_key "$repo"
  current_hash >/dev/null
  # A session runs on the VM only after a handoff, which starts here: whatever an earlier one left is stale.
  destroy_session "$id"
  ensure_session_dirs "$id"
  worktree=$WORKTREES/$id
  install -d -o "$HOST_USER" -g "$HOST_USER" -m 0755 "$WORKTREES" "$worktree"
  # The unborn branch only marks the empty repository; prepare checks the session's own branch out.
  sandbox --mount "$worktree" -- sh -c 'git init --quiet --initial-branch=hunt-handoff "$1" && printf ".hunt/\n" >>"$1/.git/info/exclude"' sh "$worktree"
  created_at=$(now_ms)
  jq -n --arg repo "$repo" --arg worktree "$worktree" --argjson createdAt "$created_at" \
    '{repo: $repo, worktree: $worktree, createdAt: $createdAt}' >"$SESSIONS/$id/meta.json.tmp"
  mv -f "$SESSIONS/$id/meta.json.tmp" "$SESSIONS/$id/meta.json"
  emit --arg path "$worktree" '{path: $path}'
}

# git push and git fetch from Hunt reach a session's repository only through these, inside the sandbox.
cmd_receive_pack() {
  (( $# == 1 )) || usage
  local id
  id=$(session_of_path "$1")
  sandbox --stdin --mount "$WORKTREES/$id" -- git-receive-pack "$WORKTREES/$id"
}

cmd_upload_pack() {
  (( $# == 1 )) || usage
  local id
  id=$(session_of_path "$1")
  sandbox --stdin --mount "$WORKTREES/$id" -- git-upload-pack "$WORKTREES/$id"
}

cmd_lfs_put() {
  (( $# == 1 )) || usage
  local id=$1 repository
  require_id "$id"
  repository=$WORKTREES/$id/.git
  [[ -d $repository ]] || die "session $id has no repository on this VM"
  sandbox --stdin --mount "$WORKTREES/$id" -- sh -c 'mkdir -p "$1" && tar -xzf - -C "$1"' sh "$repository/lfs/objects"
  emit '{}'
}

cmd_lfs_get() {
  (( $# == 1 )) || usage
  local id=$1 line
  local -a objects=()
  require_id "$id"
  require_prepared "$id"
  while IFS= read -r line; do
    [[ -z $line ]] && continue
    [[ $line =~ ^[0-9a-f]{2}/[0-9a-f]{2}/[0-9a-f]{64}$ ]] || die "invalid LFS object path: $line"
    objects+=("$line")
  done
  (( ${#objects[@]} )) || die "no LFS objects requested"
  sandbox --mount "$WORKTREES/$id" -- tar -czf - -C "$WORKTREES/$id/.git/lfs/objects" -- "${objects[@]}"
}

cmd_put_files() {
  (( $# == 1 || $# == 2 )) || usage
  local id=$1 target
  require_id "$id"
  target=$WORKTREES/$id
  if (( $# == 2 )); then
    [[ $2 == --claude ]] || usage
    ensure_session_dirs "$id"
    target=$CLAUDE_HOMES/$id
  fi
  [[ -d $target ]] || die "session $id is not initialized on this VM"
  sandbox --stdin --mount "$target" -- tar -xzf - -C "$target"
  emit '{}'
}

cmd_get_claude() {
  (( $# == 3 )) && [[ $2 == --project ]] || usage
  local id=$1 slug=$3 home
  require_id "$id"
  [[ $slug =~ ^[A-Za-z0-9-]+$ ]] || die "invalid project folder: $slug"
  home=$CLAUDE_HOMES/$id
  [[ -d $home ]] || die "session $id has no ~/.claude on this VM"
  sandbox --mount "$home" -- sh -c 'cd "$1" && if [ -d "projects/$2" ]; then exec tar -czf - hunt-session.json "projects/$2"; else exec tar -czf - hunt-session.json; fi' sh "$home" "$slug"
}

cmd_prepare() {
  (( $# )) || usage
  local id=$1 branch='' snapshot='' git_name='' git_email='' origin='' upstream='' hooks_path=''
  require_id "$id"
  shift
  while (( $# )); do
    (( $# >= 2 )) || usage
    case $1 in
      --branch) branch=$2 ;;
      --snapshot) snapshot=$2 ;;
      --git-name) git_name=$2 ;;
      --git-email) git_email=$2 ;;
      --origin) origin=$2 ;;
      --upstream) upstream=$2 ;;
      --hooks-path) hooks_path=$2 ;;
      *) usage ;;
    esac
    shift 2
  done
  git check-ref-format --branch "$branch" >/dev/null 2>&1 || die "invalid branch: $branch"
  [[ -n $snapshot && $snapshot != -* ]] || die "invalid snapshot: $snapshot"
  require_line "git name" "$git_name"
  require_line "git email" "$git_email"
  [[ -z $origin || $origin =~ ^https://github\.com/[A-Za-z0-9_-][A-Za-z0-9._-]*/[A-Za-z0-9_-][A-Za-z0-9._-]*\.git$ ]] || die "invalid origin: $origin"
  if [[ -n $upstream ]]; then
    [[ -n $origin && $upstream != -* ]] && git check-ref-format --branch "$upstream" >/dev/null 2>&1 || die "invalid upstream: $upstream"
  fi
  [[ -z $hooks_path || ( $hooks_path =~ ^[A-Za-z0-9_.][A-Za-z0-9._/-]*$ && /$hooks_path/ != */../* ) ]] || die "invalid hooks path: $hooks_path"

  local worktree=$WORKTREES/$id hash meta_json
  [[ -f $SESSIONS/$id/meta.json && -d $worktree/.git ]] || die "session $id is not initialized on this VM; run hunt-ctl init and push first"
  hash=$(current_hash)
  # LFS files stay pointers until `git lfs checkout`, which fills in what the repository's LFS store holds. It reads the
  # LFS files of HEAD's tree, so HEAD points at the snapshot meanwhile; afterwards the branch is checked out again and
  # the snapshot's changes stay uncommitted, as they were locally.
  sandbox --mount "$worktree" -- sh -c '
    set -e
    cd "$1"
    git rev-parse --quiet --verify "refs/heads/$2^{commit}" >/dev/null || { echo "branch $2 is missing in the pushed repository" >&2; exit 1; }
    commit=$(git rev-parse --quiet --verify "$3^{commit}") || { echo "snapshot $3 is missing in the pushed repository" >&2; exit 1; }
    GIT_LFS_SKIP_SMUDGE=1 git checkout --quiet --force "$2"
    GIT_LFS_SKIP_SMUDGE=1 git read-tree -u -m HEAD "$commit"
    git update-ref --no-deref HEAD "$commit"
    git lfs checkout
    git symbolic-ref HEAD "refs/heads/$2"
    git reset -q
    if [ -n "$4" ]; then
      git config remote.origin.url "$4"
      git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
    fi
    if [ -n "$5" ]; then
      git config "branch.$2.remote" origin
      git config "branch.$2.merge" "refs/heads/$5"
    fi
    if [ -n "$6" ]; then
      git config core.hooksPath "$6"
    else
      git lfs install --local >/dev/null
    fi' sh "$worktree" "$branch" "$snapshot" "$origin" "$upstream" "$hooks_path"

  meta_json=$(jq --arg branch "$branch" --arg image "hunt-agent:$hash" --arg gitName "$git_name" --arg gitEmail "$git_email" \
    '. + {branch: $branch, image: $image, gitName: $gitName, gitEmail: $gitEmail}' "$SESSIONS/$id/meta.json")
  printf '%s\n' "$meta_json" >"$SESSIONS/$id/meta.json.tmp"
  mv -f "$SESSIONS/$id/meta.json.tmp" "$SESSIONS/$id/meta.json"
  emit --arg worktree "$worktree" '{worktree: $worktree}'
}

cmd_deps() {
  (( $# == 1 )) || usage
  local id=$1 worktree lockfile digest marker image deps_state
  local -a install_command mounts flags
  require_id "$id"
  require_prepared "$id"
  worktree=$WORKTREES/$id
  if [[ -f $worktree/package-lock.json ]]; then
    lockfile=package-lock.json install_command=(npm ci)
  elif [[ -f $worktree/pnpm-lock.yaml ]]; then
    lockfile=pnpm-lock.yaml install_command=(corepack pnpm install --frozen-lockfile)
  elif [[ -f $worktree/yarn.lock ]]; then
    lockfile=yarn.lock install_command=(corepack yarn install --immutable)
  else
    emit '{installed: false}'
    return
  fi
  digest=$(sha256sum <"$worktree/$lockfile")
  marker=$SESSIONS/$id/deps.${digest%% *}
  if [[ -e $marker ]]; then
    emit '{installed: false}'
    return
  fi

  image=$(meta "$id" image)
  ensure_session_dirs "$id"
  session_mounts "$id"
  ensure_session_network "$id"
  mapfile -t flags < <(container_flags "$id")
  # A previous run that lost its hunt-ctl (e.g. a dropped SSH connection) would race this one in node_modules.
  deps_state=$(container_state "hunt-deps-$id")
  if [[ $deps_state != missing ]]; then
    docker rm --force "hunt-deps-$id" >/dev/null
  fi
  docker run --rm --init --pull never --name "hunt-deps-$id" --memory "$CONTAINER_MEMORY" "${flags[@]}" --user "$CONTAINER_USER" \
    "${mounts[@]}" --workdir "$worktree" --env CI=1 --env CYPRESS_INSTALL_BINARY=0 --entrypoint "${install_command[0]}" "$image" "${install_command[@]:1}"
  rm -f -- "${SESSIONS:?}/${id:?}"/deps.*
  touch "$marker"
  emit '{installed: true}'
}

cmd_start() {
  (( $# == 1 )) || usage
  require_id "$1"
  require_prepared "$1"
  start_container "$1"
  emit '{container: "running"}'
}

cmd_wait() {
  (( $# )) || usage
  local id=$1 timeout=120
  require_id "$id"
  shift
  while (( $# )); do
    case $1 in
      --timeout)
        [[ ${2-} =~ ^[1-9][0-9]*$ ]] || die "invalid --timeout: ${2-}"
        timeout=$2
        shift 2
        ;;
      *) usage ;;
    esac
  done
  wait_until_ready "$id" "$timeout"
}

cmd_stop() {
  (( $# == 1 )) || usage
  local state
  require_id "$1"
  stop_preview "$1"
  state=$(container_state "hunt-$1")
  if [[ $state != missing ]]; then
    docker stop -t "$STOP_TIMEOUT" "hunt-$1" >/dev/null
  fi
  emit '{}'
}

cmd_clear() {
  (( $# == 1 )) || usage
  local id=$1 config previous state
  require_id "$id"
  require_prepared "$id"
  config=$CLAUDE_HOMES/$id/hunt-session.json
  previous=$(sandbox --mount "$CLAUDE_HOMES/$id" -- jq -c '.acpSessionId // null' "$config") || die "session $id has no readable $config"
  state=$(container_state "hunt-$id")
  # The relay rewrites the file, so it must not run while the id is cleared; it creates a new session for a null id.
  if [[ $state != missing ]]; then
    docker stop -t "$STOP_TIMEOUT" "hunt-$id" >/dev/null
  fi
  sandbox --mount "$CLAUDE_HOMES/$id" -- sh -c 'jq ".acpSessionId = null" "$1" >"$1.clear" && mv -f "$1.clear" "$1"' sh "$config"
  start_container "$id"
  wait_until_ready "$id" 120 "$previous"
}

cmd_snapshot() {
  (( $# == 1 )) || usage
  local id=$1 worktree git_name git_email result
  require_id "$id"
  require_prepared "$id"
  worktree=$WORKTREES/$id
  git_name=$(meta "$id" gitName)
  git_email=$(meta "$id" gitEmail)
  # A scratch index leaves the worktree's own index, and with it what the agent staged, untouched.
  result=$(sandbox --mount "$worktree" --env "GIT_AUTHOR_NAME=$git_name" --env "GIT_AUTHOR_EMAIL=$git_email" \
    --env "GIT_COMMITTER_NAME=$git_name" --env "GIT_COMMITTER_EMAIL=$git_email" -- sh -c '
      set -e
      cd "$1"
      export GIT_INDEX_FILE=/tmp/hunt-snapshot-index
      head=$(git rev-parse --verify HEAD)
      git read-tree HEAD
      git add -A
      tree=$(git write-tree)
      commit=$(git commit-tree -p "$head" -m "Hunt retrieve snapshot" "$tree")
      git update-ref "refs/hunt/$2/retrieve" "$commit"
      printf "%s %s\n" "$commit" "$head"' sh "$worktree" "$id")
  emit --arg snapshot "${result%% *}" --arg head "${result##* }" '{snapshot: $snapshot, head: $head}'
}

cmd_status() {
  (( $# == 1 )) || usage
  local id=$1 container status meta_json
  require_id "$id"
  container=$(container_state "hunt-$id")
  case $container in
    missing) ;;
    running | restarting | paused) container=running ;;
    *) container=exited ;;
  esac
  status=$(read_object --agent "$SOCKETS/$id/status.json")
  meta_json=$(read_object "$SESSIONS/$id/meta.json")
  emit --arg container "$container" --argjson status "$status" --argjson meta "$meta_json" '{container: $container, status: $status, meta: $meta}'
}

# Removes everything session $1 has on the VM: its containers, its network and its folders. Folders an agent wrote to are
# removed as root without following symlinks.
destroy_session() {
  local id=$1 name state
  if [[ -f $SESSIONS/$id/preview-routes.json ]]; then
    rm -f -- "$SESSIONS/$id/preview-routes.json"
    edge_sync
  fi
  for name in "hunt-$id" "hunt-deps-$id"; do
    state=$(container_state "$name")
    if [[ $state != missing ]]; then
      docker rm --force "$name" >/dev/null
    fi
  done
  remove_preview_services "$id"
  docker network rm "$(session_network "$id")" >/dev/null 2>&1 || true
  rm -rf -- "${WORKTREES:?}/${id:?}" "${CLAUDE_HOMES:?}/${id:?}" "${SOCKETS:?}/${id:?}" "${SESSIONS:?}/${id:?}" "${PREVIEW_DIR:?}/${id:?}"
}

cmd_destroy() {
  (( $# == 1 )) || usage
  require_id "$1"
  destroy_session "$1"
  emit '{}'
}

# ---- Previews -------------------------------------------------------------------------------------------------------
# A session's preview runs the `preview` section of its repository's hunt.json: services from Hunt's catalog in their
# own containers on the session's network, and the dev processes inside the session's container, supervised by the
# relay (remote/relay/preview/). The edge proxy (Caddy, container hunt-edge on the host network) routes the preview
# hosts from the load balancer to the session's container. Everything taken from hunt.json is validated twice: by the
# relay's contract in a sandbox (planCli.ts) and again here before it reaches Docker or Caddy.

readonly DOMAIN_PATTERN='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'
readonly PROCESS_PATTERN='^[a-z][a-z0-9-]{0,23}$'

# Prints the service containers of session $1, one name per line.
preview_service_containers() {
  docker ps --all --filter "label=hunt.session=$1" --filter "label=hunt.role=service" --format '{{.Names}}'
}

remove_preview_services() {
  local name
  while read -r name; do
    [[ -n $name ]] && docker rm --force "$name" >/dev/null
  done < <(preview_service_containers "$1")
}

# Checks the plan $1 that planCli.ts made for session $2 and domain $3 once more, field by field, before Docker and
# Caddy see it.
check_plan() {
  local short=${2:0:8} domain_pattern=${3//./\\.}
  jq -e --arg host "^${short}(-[0-9]{4,5})?\\.${domain_pattern}\$" --arg name "$PROCESS_PATTERN" '
    def port_ok: type == "number" and . == floor and . >= 1024 and . <= 65535
      and . != 2019 and . != 5432 and . != 6379 and (. < 9200 or . > 9249);
    (.services | type == "array" and length <= 4 and all(
      (.name | type == "string" and test($name))
      and (.kind == "postgres-18" or .kind == "redis-7.2" or .kind == "elasticsearch-9")
      and (.memoryMb | type == "number" and . >= 64 and . <= 4096)
      and (.env | type == "object" and all(to_entries[]; (.key == "POSTGRES_USER" or .key == "POSTGRES_PASSWORD" or .key == "POSTGRES_DB")
        and (.value | type == "string" and test("^[^\n\r]*$"))))))
    and (.services | map(.memoryMb) | add // 0) <= 4096
    and (.routes | type == "array" and length >= 1 and all(
      (.host | type == "string" and test($host)) and (.port | port_ok) and (.protocol == "http" or .protocol == "https")))
    and (.urls.main | type == "string")' <<<"$1" >/dev/null || die "the preview plan failed hunt-ctl's checks"
}

# Fails unless the memory limits of the running containers plus $1 MB leave MEMORY_RESERVE_MB of the VM free.
require_memory() {
  local extra_mb=$1 total_kb used=0 limit
  total_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
  while read -r limit; do
    used=$((used + limit))
  done < <(docker ps --quiet | xargs -r docker inspect --format '{{.HostConfig.Memory}}')
  (( used / 1048576 + extra_mb <= total_kb / 1024 - MEMORY_RESERVE_MB )) ||
    die "the VM has not enough memory for this preview; stop another preview or session first"
}

# Starts the catalog service $2 (kind $3, $4 MB, env JSON $5) of session $1 unless it runs.
start_preview_service() {
  local id=$1 name=$2 kind=$3 memory_mb=$4 env_json=$5 container image env_file data user=$CONTAINER_USER
  local -a args=() extra=()
  container=hunt-svc-$id-$name
  [[ $(container_state "$container") == running ]] && return
  [[ $(container_state "$container") == missing ]] || docker rm --force "$container" >/dev/null
  env_file=$SESSIONS/$id/service-$name.env
  (umask 077 && jq -r 'to_entries[] | "\(.key)=\(.value)"' <<<"$env_json" >"$env_file")
  case $kind in
    postgres-18)
      image=hunt-postgres18:$(current_hash)
      data=$PREVIEW_DIR/$id/data/$name
      install -d -o "$HOST_USER" -g "$HOST_USER" -m 0700 "$data"
      extra=(--mount "type=bind,src=$data,dst=/var/lib/postgresql" --shm-size 256m)
      args=(postgres -c shared_buffers=256MB -c fsync=off -c synchronous_commit=off -c full_page_writes=off -c max_connections=200)
      ;;
    redis-7.2)
      image=$REDIS_IMAGE
      args=(redis-server --save '' --appendonly no --maxmemory "$((memory_mb * 3 / 4))mb" --maxmemory-policy noeviction)
      ;;
    elasticsearch-9)
      image=$ELASTICSEARCH_IMAGE
      data=$PREVIEW_DIR/$id/data/$name
      install -d -o "$HOST_USER" -g "$HOST_USER" -m 0700 "$data"
      # The image runs as any uid with gid 0. Single-node mode skips the bootstrap checks that need host settings; the
      # heap takes half of the limit.
      user=${CONTAINER_USER%:*}:0
      extra=(--mount "type=bind,src=$data,dst=/usr/share/elasticsearch/data" --env discovery.type=single-node
        --env network.host=0.0.0.0 --env xpack.security.enabled=false --env xpack.ml.enabled=false
        --env xpack.watcher.enabled=false --env node.store.allow_mmap=false
        --env cluster.routing.allocation.disk.threshold_enabled=false
        --env "ES_JAVA_OPTS=-Xms$((memory_mb / 2))m -Xmx$((memory_mb / 2))m")
      ;;
    *) die "unknown service kind: $kind" ;;
  esac
  docker run --detach --name "$container" --label "hunt.session=$id" --label hunt.role=service --restart no \
    --network "$(session_network "$id")" --network-alias "$name" --user "$user" --cap-drop ALL \
    --security-opt no-new-privileges --pids-limit 512 --memory "${memory_mb}m" --memory-swap "${memory_mb}m" \
    --env-file "$env_file" "${extra[@]}" "$image" "${args[@]}" >/dev/null
}

# Waits up to 90 seconds until service container $1 of kind $2 answers.
wait_preview_service() {
  local container=$1 kind=$2 deadline=$((SECONDS + 90))
  until case $kind in
    postgres-18) docker exec "$container" pg_isready -q -h 127.0.0.1 -p 5432 ;;
    redis-7.2) [[ $(docker exec "$container" redis-cli ping 2>/dev/null) == PONG ]] ;;
    elasticsearch-9) docker exec "$container" curl -fsS 'http://127.0.0.1:9200/_cluster/health?wait_for_status=yellow&timeout=1s' >/dev/null 2>&1 ;;
  esac; do
    (( SECONDS < deadline )) || die "the preview service $container did not start within 90 seconds"
    sleep 1
  done
}

# Sends the JSON request $2 to the relay of session $1 on its preview socket and prints the answer.
relay_request() {
  local socket=$SOCKETS/$1/preview.sock answer
  [[ -S $socket && ! -L $socket ]] || die "the session's relay has no preview socket; it runs an older runtime and needs a restart"
  answer=$(printf '%s\n' "$2" | as_hunt timeout 60 socat -t 60 - "UNIX-CONNECT:$socket") || die "the relay did not answer on its preview socket"
  jq -e '.ok == true' <<<"$answer" >/dev/null 2>&1 || die "the relay refused the request: $(jq -r '.error // "no reason given"' <<<"$answer" 2>/dev/null)"
  printf '%s\n' "$answer"
}

# Stops session $1's preview: its processes (when the relay runs), services and route. Its data stays.
stop_preview() {
  local id=$1 name
  if [[ $(container_state "hunt-$id") == running && -S $SOCKETS/$id/preview.sock && -f $SESSIONS/$id/preview-plan.json ]]; then
    relay_request "$id" '{"op":"stop"}' >/dev/null || true
  fi
  while read -r name; do
    [[ -n $name ]] && docker stop --time 20 "$name" >/dev/null
  done < <(preview_service_containers "$id")
  if [[ -f $SESSIONS/$id/preview-routes.json ]]; then
    rm -f -- "$SESSIONS/$id/preview-routes.json"
    edge_sync
  fi
  rm -f -- "$SESSIONS/$id/preview-plan.json"
  if [[ $(container_state "hunt-$id") == running ]]; then
    docker update --memory "$CONTAINER_MEMORY" --memory-swap "$CONTAINER_MEMORY" "hunt-$id" >/dev/null || true
  fi
}

# Writes the edge's Caddy configuration for the routes in the JSON array $1 ({host, port, protocol, ip}). Caddy serves
# only the load balancer's ranges, passes the original Host header, removes IAP's credentials before a request reaches
# a session's dev server, and answers the health check for hosts that are no preview.
write_edge_config() {
  local ranges
  ranges=$(printf '%s\n' "${LB_RANGES[@]}" | jq -R . | jq -cs .)
  jq -n --argjson routes "$1" --argjson ranges "$ranges" --arg listen ":$EDGE_PORT" --arg health "$EDGE_HEALTH_PATH" '
    def proxy: {
      handler: "reverse_proxy",
      upstreams: [{dial: "\(.ip):\(.port)"}],
      headers: {request: {
        delete: ["X-Goog-Iap-Jwt-Assertion", "X-Goog-Authenticated-User-Email", "X-Goog-Authenticated-User-Id"],
        replace: {Cookie: [{search_regexp: "(^|;\\s*)(__Host-)?GCP_IAP[^=]*=[^;]*", replace: ""}]}}}
    } + (if .protocol == "https" then {transport: {protocol: "http", tls: {insecure_skip_verify: true}}} else {} end);
    {
      admin: {listen: "unix//tmp/caddy-admin.sock"},
      logging: {logs: {
        default: {level: "WARN", exclude: ["http.log.access.preview"]},
        access: {
          writer: {output: "file", filename: "/var/log/hunt-edge/access.log", roll_size_mb: 20, roll_keep: 2},
          encoder: {format: "filter", wrap: {format: "json"}, fields: {
            "request>headers>Cookie": {filter: "delete"},
            "request>headers>X-Goog-Iap-Jwt-Assertion": {filter: "delete"}}},
          include: ["http.log.access.preview"]}}},
      apps: {http: {servers: {preview: {
        listen: [$listen],
        automatic_https: {disable: true},
        trusted_proxies: {source: "static", ranges: $ranges},
        logs: {default_logger_name: "preview"},
        routes: ([$routes[] | {
            match: [{host: [.host]}],
            terminal: true,
            handle: [{handler: "subroute", routes: [
              {match: [{not: [{remote_ip: {ranges: $ranges}}]}], handle: [{handler: "static_response", status_code: 403}], terminal: true},
              {handle: [proxy]}]}]}]
          + [{match: [{path: [$health]}], terminal: true,
              handle: [{handler: "vars", log_skip: true}, {handler: "static_response", status_code: 200, body: "ok"}]},
             {handle: [{handler: "vars", log_skip: true}, {handler: "static_response", status_code: 404}]}])}}}}
    }' >"$EDGE_CONFIG_DIR/caddy.json.tmp"
  mv -f "$EDGE_CONFIG_DIR/caddy.json.tmp" "$EDGE_CONFIG_DIR/caddy.json"
}

# Starts the edge proxy unless it runs with the pinned image.
ensure_edge() {
  local state
  install -d -m 0755 "$EDGE_CONFIG_DIR"
  install -d -o "${EDGE_USER%:*}" -g "${EDGE_USER#*:}" -m 0755 "$EDGE_LOG_DIR"
  [[ -f $EDGE_CONFIG_DIR/caddy.json ]] || write_edge_config '[]'
  state=$(container_state "$EDGE_NAME")
  if [[ $state == running && $(docker inspect --format '{{.Config.Image}}' "$EDGE_NAME") == "$EDGE_IMAGE" ]]; then
    return
  fi
  [[ $state == missing ]] || docker rm --force "$EDGE_NAME" >/dev/null
  docker run --detach --name "$EDGE_NAME" --restart on-failure:5 --network host --user "$EDGE_USER" --read-only \
    --tmpfs /tmp --tmpfs /data --tmpfs /config --cap-drop ALL --security-opt no-new-privileges --memory 256m \
    --pids-limit 256 --mount "type=bind,src=$EDGE_CONFIG_DIR,dst=/etc/hunt-edge,readonly" \
    --mount "type=bind,src=$EDGE_LOG_DIR,dst=/var/log/hunt-edge" "$EDGE_IMAGE" caddy run --config /etc/hunt-edge/caddy.json >/dev/null
}

# Rebuilds the edge's routes from every session with a running preview, at its container's current address.
edge_sync() {
  local file id address routes='[]'
  for file in "$SESSIONS"/*/preview-routes.json; do
    id=${file#"$SESSIONS"/}
    id=${id%%/*}
    address=$(docker inspect --format "{{with index .NetworkSettings.Networks \"$(session_network "$id")\"}}{{.IPAddress}}{{end}}" "hunt-$id" 2>/dev/null) || continue
    [[ $address =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
    routes=$(jq -c --arg ip "$address" --argjson known "$routes" '$known + [.[] | {host, port, protocol, ip: $ip}]' "$file")
  done
  write_edge_config "$routes"
  ensure_edge
  docker exec "$EDGE_NAME" caddy reload --config /etc/hunt-edge/caddy.json --address unix//tmp/caddy-admin.sock >/dev/null
}

cmd_preview_start() {
  local id=$1 domain='' hunt_json plan generation_file generation extra_mb name kind memory env_json recreated=false turn
  local -a with_args=()
  require_id "$id"
  shift
  while (( $# )); do
    (( $# >= 2 )) || usage
    case $1 in
      --domain) domain=$2 ;;
      --with)
        [[ $2 =~ $PROCESS_PATTERN ]] || die "invalid process: $2"
        with_args+=(--with "$2")
        ;;
      *) usage ;;
    esac
    shift 2
  done
  require_prepared "$id"
  [[ $domain =~ $DOMAIN_PATTERN ]] || die "invalid preview domain: $domain"
  [[ $(container_state "hunt-$id") == running ]] || die "the session's container is not running; run hunt-ctl start first"
  if [[ ! -S $SOCKETS/$id/preview.sock ]]; then
    # The container comes from a release without previews. It is created anew from the current one (the Claude token
    # comes from stdin, as for start), which restarts the agent: only while no turn runs.
    turn=$(read_object --agent "$SOCKETS/$id/status.json" | jq -r '.turn // "idle"')
    [[ $turn != running ]] || die "the agent is working; open the preview once its turn has ended"
    docker rm --force "hunt-$id" >/dev/null
    start_container "$id"
    wait_until_ready "$id" 180 3>/dev/null
    recreated=true
  fi

  # Read in the session's container, so that a symlink the agent left can point only at what the agent sees anyway.
  hunt_json=$(docker exec --user "$CONTAINER_USER" "hunt-$id" head -c 262144 "$WORKTREES/$id/hunt.json") ||
    die "the repository has no hunt.json in its root"
  plan=$(printf '%s' "$hunt_json" | sandbox --stdin -- /opt/hunt/node/bin/node /opt/hunt/relay/preview/planCli.ts \
    --session "$id" --domain "$domain" "${with_args[@]}") || die "the preview section of hunt.json is not valid (see above)"
  check_plan "$plan" "$id" "$domain"

  if [[ ! -f $SESSIONS/$id/preview-plan.json ]]; then
    extra_mb=$(( $(numfmt --from=iec "${PREVIEW_MEMORY^^}") / 1048576 - $(numfmt --from=iec "${CONTAINER_MEMORY^^}") / 1048576 ))
    extra_mb=$((extra_mb + $(jq '[.services[].memoryMb] | add // 0' <<<"$plan")))
    require_memory "$extra_mb"
  fi

  install -d -m 0755 "$PREVIEW_DIR" "$PREVIEW_DIR/$id"
  generation_file=$PREVIEW_DIR/$id/generation
  if [[ ! -d $PREVIEW_DIR/$id/data ]]; then
    install -d -o "$HOST_USER" -g "$HOST_USER" -m 0700 "$PREVIEW_DIR/$id/data"
    date +%s%N >"$generation_file"
  fi
  generation=$(tr -d '[:space:]' <"$generation_file")
  while IFS=$'\t' read -r name kind memory env_json; do
    start_preview_service "$id" "$name" "$kind" "$memory" "$env_json"
  done < <(jq -r '.services[] | [.name, .kind, (.memoryMb | tostring), (.env | tojson)] | @tsv' <<<"$plan")
  while IFS=$'\t' read -r name kind; do
    wait_preview_service "hunt-svc-$id-$name" "$kind"
  done < <(jq -r '.services[] | [.name, .kind] | @tsv' <<<"$plan")

  (umask 077 && printf '%s\n' "$plan" >"$SESSIONS/$id/preview-plan.json")
  docker update --memory "$PREVIEW_MEMORY" --memory-swap "$PREVIEW_MEMORY" "hunt-$id" >/dev/null
  relay_request "$id" "$(jq -cn --argjson plan "$plan" --arg generation "$generation" '{op: "apply", plan: $plan, dataGeneration: $generation}')" >/dev/null
  jq -c '[.routes[] | {host, port, protocol}]' <<<"$plan" >"$SESSIONS/$id/preview-routes.json"
  edge_sync
  emit --argjson recreated "$recreated" '{state: "starting", recreated: $recreated}'
}

cmd_preview_status() {
  (( $# == 1 )) || usage
  local id=$1 plan=null relay services='{}' name
  require_id "$id"
  if [[ -f $SESSIONS/$id/preview-plan.json ]]; then
    plan=$(jq -c . "$SESSIONS/$id/preview-plan.json")
  fi
  relay=$(read_object --agent "$SOCKETS/$id/preview/preview.json")
  while read -r name; do
    [[ -n $name ]] || continue
    services=$(jq -c --arg name "${name#"hunt-svc-$id-"}" --arg state "$(container_state "$name")" '. + {($name): $state}' <<<"$services")
  done < <(preview_service_containers "$id")
  emit --argjson plan "$plan" --argjson relay "$relay" --argjson services "$services" '{
    active: ($plan != null),
    processes: [$plan.processes[]? | {name, port: (.port // null), main: (.main // false), optional: (.optional // false)}],
    services: $services,
    relay: $relay}'
}

cmd_preview_logs() {
  (( $# >= 2 )) || usage
  local id=$1 name=$2 offset='' limit=65536 file size text
  require_id "$id"
  [[ $name == setup || $name =~ $PROCESS_PATTERN ]] || die "invalid log name: $name"
  shift 2
  while (( $# )); do
    (( $# >= 2 )) || usage
    case $1 in
      --offset)
        [[ $2 =~ ^[0-9]+$ ]] || die "invalid --offset: $2"
        offset=$2
        ;;
      --limit)
        [[ $2 =~ ^[1-9][0-9]{0,6}$ && $2 -le 1048576 ]] || die "invalid --limit: $2"
        limit=$2
        ;;
      *) usage ;;
    esac
    shift 2
  done
  file=$SOCKETS/$id/preview/logs/$name.log
  if [[ ! -f $file || -L $file ]]; then
    emit '{size: 0, offset: 0, text: "", reset: false}'
    return
  fi
  size=$(as_hunt stat -c %s "$file")
  local reset=false
  if [[ -z $offset ]] || (( offset > size )); then
    [[ -n $offset ]] && reset=true
    offset=$(( size > limit ? size - limit : 0 ))
  fi
  text=$(as_hunt tail -c "+$((offset + 1))" "$file" | head -c "$limit" | jq -Rs .)
  emit --argjson size "$size" --argjson offset "$offset" --argjson text "$text" --argjson reset "$reset" \
    '{size: $size, offset: $offset, text: $text, reset: $reset}'
}

cmd_preview_restart() {
  (( $# == 2 )) || usage
  require_id "$1"
  [[ $2 =~ $PROCESS_PATTERN ]] || die "invalid process: $2"
  [[ -f $SESSIONS/$1/preview-plan.json ]] || die "session $1 has no running preview"
  relay_request "$1" "$(jq -cn --arg process "$2" '{op: "restart", process: $process}')" >/dev/null
  emit '{}'
}

cmd_preview_stop() {
  (( $# == 1 )) || usage
  require_id "$1"
  stop_preview "$1"
  emit '{}'
}

cmd_preview_reset() {
  (( $# == 1 )) || usage
  require_id "$1"
  stop_preview "$1"
  remove_preview_services "$1"
  rm -rf -- "${PREVIEW_DIR:?}/${1:?}"
  emit '{}'
}

cmd_preview() {
  (( $# )) || usage
  local subcommand=$1
  shift
  case $subcommand in
    start) cmd_preview_start "$@" ;;
    status) cmd_preview_status "$@" ;;
    logs) cmd_preview_logs "$@" ;;
    restart) cmd_preview_restart "$@" ;;
    stop) cmd_preview_stop "$@" ;;
    reset) cmd_preview_reset "$@" ;;
    *) usage ;;
  esac
}

# At boot no preview runs: the services stay down and the relays do not resume them, so routes and plans are dropped.
cmd_edge_reset() {
  (( $# == 0 )) || usage
  local file id name
  for file in "$SESSIONS"/*/preview-plan.json "$SESSIONS"/*/preview-routes.json; do
    rm -f -- "$file"
  done
  while read -r name; do
    [[ -n $name ]] && docker rm --force "$name" >/dev/null
  done < <(docker ps --all --filter label=hunt.role=service --format '{{.Names}}')
  install -d -m 0755 "$EDGE_CONFIG_DIR"
  write_edge_config '[]'
  if [[ $(container_state "$EDGE_NAME") != missing ]]; then
    docker rm --force "$EDGE_NAME" >/dev/null
  fi
  ensure_edge
  for id in "$SESSIONS"/*/; do
    id=${id%/}
    id=${id##*/}
    [[ $(container_state "hunt-$id") == running ]] &&
      docker update --memory "$CONTAINER_MEMORY" --memory-swap "$CONTAINER_MEMORY" "hunt-$id" >/dev/null 2>&1 || true
  done
  emit '{}'
}

main() {
  (( $# )) || usage
  (( EUID == 0 )) || die "must run as root: sudo -n hunt-ctl $*"
  cd /
  umask 022
  local command=$1
  shift
  case "$command ${1-}" in
    "version "* | "status "* | "preview status" | "preview logs" | "edge-reset "*) counts_as_activity=false ;;
  esac
  install -d -m 0755 "$STATE_DIR"
  if $counts_as_activity; then
    touch "$ACTIVITY_FILE"
  fi
  trap on_exit EXIT
  # Streaming commands pass raw data on stdout; the others print one JSON document there.
  case $command in
    receive-pack)
      cmd_receive_pack "$@"
      return
      ;;
    upload-pack)
      cmd_upload_pack "$@"
      return
      ;;
    lfs-get)
      cmd_lfs_get "$@"
      return
      ;;
    get-claude)
      cmd_get_claude "$@"
      return
      ;;
  esac
  # From here on stdout carries only the result (fd 3); everything else the commands print goes to stderr.
  exec 3>&1 1>&2
  case $command in
    install) cmd_install "$@" ;;
    install-units) cmd_install_units "$@" ;;
    version) cmd_version "$@" ;;
    init) cmd_init "$@" ;;
    lfs-put) cmd_lfs_put "$@" ;;
    put-files) cmd_put_files "$@" ;;
    prepare) cmd_prepare "$@" ;;
    deps) cmd_deps "$@" ;;
    start) cmd_start "$@" ;;
    wait) cmd_wait "$@" ;;
    stop) cmd_stop "$@" ;;
    clear) cmd_clear "$@" ;;
    snapshot) cmd_snapshot "$@" ;;
    status) cmd_status "$@" ;;
    destroy) cmd_destroy "$@" ;;
    preview) cmd_preview "$@" ;;
    edge-reset) cmd_edge_reset "$@" ;;
    *) usage ;;
  esac
}

trap 'report_failure $? $LINENO "$BASH_COMMAND"' ERR
main "$@"
