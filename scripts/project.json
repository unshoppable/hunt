{
  "name": "scripts",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "type:tooling"
  ],
  "targets": {
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.scripts.json"
      },
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.scripts.json"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint scripts"
      }
    }
  }
}
