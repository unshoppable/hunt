{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hunt",
  "version": "0.1.0",
  "identifier": "info.medconomy.harness",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hunt",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 23 },
        "visible": false,
        "backgroundColor": "#21252d",
        "center": true,
        "width": 1500,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../node_modules/@agentclientprotocol/": "node_modules/@agentclientprotocol/",
      "../node_modules/@anthropic-ai/": "node_modules/@anthropic-ai/",
      "../node_modules/zod/": "node_modules/zod/",
      "../node_modules/diff/": "node_modules/diff/"
    }
  }
}
